# ─── AI / API Keys ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ─── TTS Settings ──────────────────────────────────────────────
# OpenAI TTS model: tts-1 (fast) or tts-1-hd (highest quality)
TTS_MODEL=tts-1-hd
# OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
# "nova" = warm & natural (recommended for guidance)
# "shimmer" = expressive & clear
TTS_VOICE_NAME=nova

# ─── Navigation Distance Zones (cm) ────────────────────────────
# HC-SR04 reliable range: 2 cm – 400 cm
# Tune these to match the spaces you walk through.
ZONE_CRITICAL_CM=50     # Imminent collision → voice + camera analysis
ZONE_DANGER_CM=120      # Very close → rapid beeps + voice warning
ZONE_CAUTION_CM=200     # Approaching → faster beeps + voice cue
ZONE_AWARE_CM=350       # Environmental awareness → slow beeps only
CLEAR_PATH_COOLDOWN=8.0 # Seconds between "path is clear" announcements

# ─── GPIO Pin Assignments (BCM numbering) ──────────────────────
# Ultrasonic Sensors (HC-SR04)
US_FRONT_TRIG=23
US_FRONT_ECHO=24
US_LEFT_TRIG=5
US_LEFT_ECHO=6
US_RIGHT_TRIG=17
US_RIGHT_ECHO=27

# Wrist Button Pad
BTN_1_PIN=16   # Describe scene
BTN_2_PIN=20   # Read text / signs
BTN_3_PIN=21   # Toggle navigation mode
BTN_4_PIN=12   # Repeat last output

# ─── Camera ────────────────────────────────────────────────────
CAMERA_RESOLUTION=1280x720
CAMERA_FRAMERATE=30

# ─── Misc ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
